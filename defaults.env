: "${MAP_PATH:=${ROOT_DIR:-$PWD}/maps/whale_map_20251107}"
: "${MAP_RVIZ_LEAF_SIZE:=0.5}"

: "${LAUNCH_SENSING:=true}"
: "${LAUNCH_LOCALIZATION:=true}"
: "${LAUNCH_PLANNING:=true}"
: "${LAUNCH_CONTROL:=true}"
: "${LAUNCH_SAFETY:=true}"
: "${LAUNCH_VEHICLE:=true}"
: "${LAUNCH_RVIZ:=false}"
: "${LAUNCH_IMU:=true}"
: "${LAUNCH_FIXPOSITION:=false}"
: "${LAUNCH_FIXPOSITION_SEED:=false}"
: "${LAUNCH_MANUAL_SEED:=true}"
: "${LAUNCH_MAP_PROJECTION_LOADER:=true}"

: "${ENABLE_DRIVE_COMMANDS:=false}"
: "${MAX_SPEED_MPS:=3.0}"
: "${SERIAL_PORT:=}"
: "${SERIAL_BAUDRATE:=115200}"
: "${IMU_SERIAL_PORT:=/dev/ttyUSB0}"
: "${IMU_BAUDRATE:=115200}"
: "${VEHICLE_INTERFACE:=rc_serial}"
: "${WHEEL_BASE_M:=0.6}"
: "${MAX_STEER_RAD:=0.262}"
: "${CONTROL_MIN_LOOKAHEAD_M:=1.0}"
: "${CONTROL_LOOKAHEAD_GAIN:=1.0}"
: "${CONTROL_GOAL_TOLERANCE_M:=0.35}"
: "${CONTROL_MAX_STEER_RATE_RADPS:=1.5}"

: "${EXTRINSICS_FILE:=${ROOT_DIR:-$PWD}/src/autoracer_description/config/rc_sensor_extrinsics.yaml}"
: "${MANUAL_SEED_INPUT_TOPIC:=/initialpose}"
: "${MANUAL_SEED_REQUIRE_INPUT_POSE:=true}"
: "${MANUAL_SEED_X:=0.0}"
: "${MANUAL_SEED_Y:=0.0}"
: "${MANUAL_SEED_Z:=0.0}"
: "${MANUAL_SEED_YAW:=0.0}"
: "${MANUAL_SEED_XY_VARIANCE:=1.0}"
: "${MANUAL_SEED_Z_VARIANCE:=0.25}"
: "${MANUAL_SEED_YAW_VARIANCE:=0.03}"
: "${NDT_PARAM_FILE:=${ROOT_DIR:-$PWD}/install/autoracer_bringup/share/autoracer_bringup/config/rc/ndt_scan_matcher.param.yaml}"
: "${NDT_INITIAL_POSE_STAMP_OFFSET_SEC:=-0.10}"

: "${LIDAR_DRIVER:=lslidar_c32}"
: "${LIDAR_IFACE:=enP8p1s0}"
: "${LIDAR_PARAM_FILE:=${ROOT_DIR:-$PWD}/install/autoracer_bringup/share/autoracer_bringup/config/rc/lslidar_cx.yaml}"
: "${LIDAR_HOST_IP:=192.168.1.102}"
: "${LIDAR_SENSOR_IP:=192.168.1.200}"
: "${LIDAR_DATA_PORT:=2368}"
: "${LIDAR_SENSOR_MODEL:=C32}"
: "${FIXPOSITION_STREAM:=tcpcli://192.168.1.200:21000}"

: "${LAUNCH_POINTCLOUD_FILTER:=true}"
: "${POINTCLOUD_FILTER_INPUT_TOPIC:=/sensing/lidar/concatenated/pointcloud}"
: "${POINTCLOUD_FILTER_OUTPUT_TOPIC:=/sensing/lidar/filtered/pointcloud}"
: "${POINTCLOUD_FILTER_LEAF_SIZE_M:=0.25}"
: "${POINTCLOUD_FILTER_MIN_RANGE_M:=0.15}"
: "${POINTCLOUD_FILTER_MAX_RANGE_M:=60.0}"
: "${POINTCLOUD_FILTER_MAX_POINTS:=1500}"
: "${LOCALIZATION_POINTCLOUD_TOPIC:=/sensing/lidar/filtered/pointcloud}"
