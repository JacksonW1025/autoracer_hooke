<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hooke2_vehicle">
  <!-- load parameter -->
  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find hooke2_description)/config/vehicle_info.param.yaml')}"/>
  <xacro:property name="wheel_radius" value="${vehicle_info['/**']['ros__parameters']['wheel_radius']}"/>
  <xacro:property name="lidar_top_mount_z" value="${1.65 - wheel_radius}"/>
  <xacro:property name="lidar_top_mount_yaw" value="1.57079632679"/>
  <xacro:property name="gnss_imu_mount_z" value="${1.35 - wheel_radius}"/>

  <material name="lidar_shell">
    <color rgba="0.05 0.08 0.10 1.0"/>
  </material>
  <material name="lidar_glass">
    <color rgba="0.00 0.55 0.95 0.75"/>
  </material>
  <material name="nav_orange">
    <color rgba="1.00 0.45 0.08 1.0"/>
  </material>
  <material name="imu_dark">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>

  <!-- vehicle body -->
  <link name="base_link">
    <visual>
      <origin xyz="${vehicle_info['/**']['ros__parameters']['wheel_base']/2.0} 0 0" rpy="${pi/2.0} 0 ${pi}"/>
      <geometry>
        <mesh filename="package://hooke2_description/mesh/dtv.fbx" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- Top-front LiDAR. Old Hooke2/X1 heights were ground-referenced, and scan axes need +90deg yaw into base_link. -->
  <joint name="lidar_top_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_top_base_link"/>
    <origin xyz="1.90 0 ${lidar_top_mount_z}" rpy="0 0 ${lidar_top_mount_yaw}"/>
  </joint>

  <link name="lidar_top_base_link">
    <visual name="mount_plate">
      <origin xyz="0 0 -0.018" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.036"/>
      </geometry>
      <material name="lidar_shell"/>
    </visual>
    <visual name="lidar_body">
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.095" length="0.100"/>
      </geometry>
      <material name="lidar_glass"/>
    </visual>
  </link>

  <joint name="lidar_top_scan_joint" type="fixed">
    <parent link="lidar_top_base_link"/>
    <child link="lidar_top"/>
    <origin xyz="0 0 0.047" rpy="0 0 0"/>
  </joint>

  <link name="lidar_top">
    <visual name="scan_frame_marker">
      <origin xyz="0 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.115" length="0.012"/>
      </geometry>
      <material name="lidar_shell"/>
    </visual>
  </link>

  <!-- GNSS/INS unit mounted below the top-front LiDAR. Antenna disks are intentionally omitted. -->
  <joint name="gnss_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_base_link"/>
    <origin xyz="1.90 0 ${gnss_imu_mount_z}" rpy="0 0 -1.57079632679"/>
  </joint>

  <link name="gnss_base_link">
    <visual name="navigation_box">
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.20 0.09"/>
      </geometry>
      <material name="nav_orange"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="1.90 0 ${gnss_imu_mount_z}" rpy="0 0 -1.57079632679"/>
  </joint>

  <link name="imu_link">
    <visual name="imu_core">
      <origin xyz="0 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.09 0.035"/>
      </geometry>
      <material name="imu_dark"/>
    </visual>
  </link>
</robot>
