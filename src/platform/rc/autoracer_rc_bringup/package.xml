<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoracer_rc_bringup</name>
  <version>0.1.0</version>
  <description>RC platform sensing and chassis bringup.</description>
  <maintainer email="autoracer@example.com">Autoracer Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>autoracer_localization</exec_depend>
  <exec_depend>autoracer_planning</exec_depend>
  <exec_depend>autoracer_rc_adapter</exec_depend>
  <exec_depend>autoracer_rc_description</exec_depend>
  <exec_depend>autoware_gnss_poser</exec_depend>
  <exec_depend>hipnuc_imu</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lslidar_driver</exec_depend>
  <exec_depend>nmea_navsat_driver</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
