+std::optional<double> PoseCovarianceModifierNode::gnss_ndt_xy_innovation(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg) const
+{
+  const auto reference = gnss_ndt_xy_reference(msg);
+  if (!reference) {
+    return std::nullopt;
+  }
+  const double innovation_m =
+    std::hypot(
+    msg.pose.pose.position.x - (*reference)[0],
+    msg.pose.pose.position.y - (*reference)[1]);
+  if (!std::isfinite(innovation_m)) {
+    return std::nullopt;
+  }
+  return innovation_m;
+}
+
+std::optional<std::array<double, 2>> PoseCovarianceModifierNode::gnss_ndt_xy_reference(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg) const
+{
+  if (!ndt_pose_with_cov_last_) {
+    return std::nullopt;
+  }
+  double reference_x = ndt_pose_with_cov_last_->pose.pose.position.x;
+  double reference_y = ndt_pose_with_cov_last_->pose.pose.position.y;
+  if (gnss_ndt_motion_compensate_innovation_ && ndt_pose_with_cov_previous_) {
+    const rclcpp::Time previous_stamp(
+      ndt_pose_with_cov_previous_->header.stamp, this->get_clock()->get_clock_type());
+    const rclcpp::Time latest_stamp(
+      ndt_pose_with_cov_last_->header.stamp, this->get_clock()->get_clock_type());
+    const rclcpp::Time gnss_stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+    const double ndt_interval_sec = (latest_stamp - previous_stamp).seconds();
+    const double gnss_from_latest_sec = (gnss_stamp - latest_stamp).seconds();
+    if (
+      std::isfinite(ndt_interval_sec) && ndt_interval_sec > 1.0e-6 &&
+      std::isfinite(gnss_from_latest_sec)) {
+      const double velocity_x =
+        (ndt_pose_with_cov_last_->pose.pose.position.x -
+         ndt_pose_with_cov_previous_->pose.pose.position.x) /
+        ndt_interval_sec;
+      const double velocity_y =
+        (ndt_pose_with_cov_last_->pose.pose.position.y -
+         ndt_pose_with_cov_previous_->pose.pose.position.y) /
+        ndt_interval_sec;
+      reference_x += velocity_x * gnss_from_latest_sec;
+      reference_y += velocity_y * gnss_from_latest_sec;
+    }
+  }
+  if (!std::isfinite(reference_x) || !std::isfinite(reference_y)) {
+    return std::nullopt;
+  }
+  return std::array<double, 2>{reference_x, reference_y};
+}
+
+bool PoseCovarianceModifierNode::causal_conflict_allows_gnss(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg,
+  const std::array<double, 2> & ndt_reference, const double innovation_m)
+{
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  const CausalSourcePair current{
+    stamp.nanoseconds(),
+    msg.pose.pose.position.x,
+    msg.pose.pose.position.y,
+    ndt_reference[0],
+    ndt_reference[1]};
+
+  if (
+    causal_source_pair_last_ &&
+    static_cast<double>(current.stamp_ns - causal_source_pair_last_->stamp_ns) * 1.0e-9 >
+    gnss_ndt_causal_reset_gap_sec_) {
+    conflict_state_ = ConflictState::UNTRUSTED;
+    causal_agreement_count_ = 0;
+    causal_ndt_suspect_updates_left_ = 0;
+    causal_source_pair_previous_.reset();
+    causal_source_pair_last_.reset();
+  }
+
+  double gnss_prediction_error = 0.0;
+  double ndt_prediction_error = 0.0;
+  bool prediction_available = false;
+  if (causal_source_pair_previous_ && causal_source_pair_last_) {
+    const double previous_interval_sec =
+      static_cast<double>(
+      causal_source_pair_last_->stamp_ns - causal_source_pair_previous_->stamp_ns) *
+      1.0e-9;
+    const double current_interval_sec =
+      static_cast<double>(current.stamp_ns - causal_source_pair_last_->stamp_ns) * 1.0e-9;
+    if (
+      std::isfinite(previous_interval_sec) && previous_interval_sec > 1.0e-6 &&
+      std::isfinite(current_interval_sec) && current_interval_sec > 0.0 &&
+      current_interval_sec <= gnss_ndt_causal_reset_gap_sec_) {
+      const double ratio = current_interval_sec / previous_interval_sec;
+      const double gnss_predicted_x =
+        causal_source_pair_last_->gnss_x +
+        ratio * (causal_source_pair_last_->gnss_x - causal_source_pair_previous_->gnss_x);
+      const double gnss_predicted_y =
+        causal_source_pair_last_->gnss_y +
+        ratio * (causal_source_pair_last_->gnss_y - causal_source_pair_previous_->gnss_y);
+      const double ndt_predicted_x =
+        causal_source_pair_last_->ndt_x +
+        ratio * (causal_source_pair_last_->ndt_x - causal_source_pair_previous_->ndt_x);
+      const double ndt_predicted_y =
+        causal_source_pair_last_->ndt_y +
+        ratio * (causal_source_pair_last_->ndt_y - causal_source_pair_previous_->ndt_y);
+      gnss_prediction_error =
+        std::hypot(current.gnss_x - gnss_predicted_x, current.gnss_y - gnss_predicted_y);
+      ndt_prediction_error =
+        std::hypot(current.ndt_x - ndt_predicted_x, current.ndt_y - ndt_predicted_y);
+      prediction_available =
+        std::isfinite(gnss_prediction_error) && std::isfinite(ndt_prediction_error);
+    }
+  }
+
+  const bool gnss_jump =
+    prediction_available &&
+    gnss_prediction_error >= gnss_ndt_causal_source_jump_m_ &&
+    gnss_prediction_error >=
+    ndt_prediction_error + gnss_ndt_causal_source_jump_margin_m_;
+  const bool ndt_jump =
+    prediction_available &&
+    ndt_prediction_error >= gnss_ndt_causal_source_jump_m_ &&
+    ndt_prediction_error >=
+    gnss_prediction_error + gnss_ndt_causal_source_jump_margin_m_;
+
+  bool allow = false;
+  if (innovation_m > gnss_ndt_xy_innovation_max_m_ || gnss_jump) {
+    conflict_state_ = ConflictState::GNSS_SUSPECT;
+    causal_agreement_count_ = 0;
+    causal_ndt_suspect_updates_left_ = 0;
+  } else {
+    switch (conflict_state_) {
+      case ConflictState::UNTRUSTED:
+        if (innovation_m < gnss_ndt_causal_trust_agreement_m_) {
+          ++causal_agreement_count_;
+          if (causal_agreement_count_ >= gnss_ndt_causal_warmup_count_) {
+            conflict_state_ = ConflictState::TRUSTED;
+            allow = true;
+          }
+        } else if (innovation_m >= gnss_ndt_causal_conflict_m_) {
+          conflict_state_ = ConflictState::GNSS_SUSPECT;
+          causal_agreement_count_ = 0;
+        } else {
+          causal_agreement_count_ = 0;
+        }
+        break;
+      case ConflictState::TRUSTED:
+        if (innovation_m <= gnss_ndt_causal_conflict_m_) {
+          allow = true;
+        } else if (ndt_jump) {
+          conflict_state_ = ConflictState::NDT_SUSPECT;
+          causal_ndt_suspect_updates_left_ =
+            gnss_ndt_causal_ndt_suspect_update_budget_;
+          allow = true;
+        } else {
+          conflict_state_ = ConflictState::GNSS_SUSPECT;
+        }
+        break;
+      case ConflictState::NDT_SUSPECT:
+        if (innovation_m < gnss_ndt_causal_trust_agreement_m_) {
+          conflict_state_ = ConflictState::TRUSTED;
+          allow = true;
+        } else if (
+          causal_ndt_suspect_updates_left_ > 0 &&
+          (!prediction_available ||
+          gnss_prediction_error < gnss_ndt_causal_source_jump_m_)) {
+          --causal_ndt_suspect_updates_left_;
+          allow = true;
+        } else {
+          conflict_state_ = ConflictState::GNSS_SUSPECT;
+          causal_ndt_suspect_updates_left_ = 0;
+        }
+        break;
+      case ConflictState::GNSS_SUSPECT:
+        break;
+    }
+  }
+
+  causal_source_pair_previous_ = causal_source_pair_last_;
+  causal_source_pair_last_ = current;
+  return allow;
+}
