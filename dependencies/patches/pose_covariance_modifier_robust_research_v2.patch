+TEST(PoseCovarianceModifier, ndt_primary_position_motion_compensates_only_innovation_gate)
+{
+  const auto exercise = [](const bool enabled) {
+    ModifierHarness harness("ndt_primary_position", 1.0, 0.25, 0.2, enabled);
+    auto ndt_previous = harness.make_message(0.15);
+    ndt_previous.pose.pose.position.x = 10.0;
+    auto ndt_latest = ndt_previous;
+    ndt_latest.header.stamp =
+      (rclcpp::Time(ndt_previous.header.stamp) + rclcpp::Duration::from_seconds(0.1));
+    ndt_latest.pose.pose.position.x = 11.0;
+    auto gnss = ndt_latest;
+    gnss.header.stamp =
+      (rclcpp::Time(ndt_latest.header.stamp) + rclcpp::Duration::from_seconds(0.1));
+    gnss.pose.pose.position.x = 12.0;
+    gnss.pose.covariance[0] = 0.01;
+    gnss.pose.covariance[7] = 0.01;
+
+    harness.publish_ndt(ndt_previous);
+    harness.publish_ndt(ndt_latest);
+    harness.clear();
+    harness.publish_gnss(gnss);
+    return harness.outputs();
+  };
+
+  EXPECT_TRUE(exercise(false).empty());
+  const auto compensated = exercise(true);
+  ASSERT_EQ(compensated.size(), 1U);
+  EXPECT_DOUBLE_EQ(compensated.front().pose.pose.position.x, 12.0);
+}
