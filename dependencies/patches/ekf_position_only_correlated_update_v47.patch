+TEST(time_delay_kalman_filter, position_only_standard_update_conditions_correlated_motion_state)
+{
+  Eigen::MatrixXd state = Eigen::MatrixXd::Zero(8, 1);
+  Eigen::MatrixXd covariance = Eigen::MatrixXd::Identity(8, 8);
+  // x and yaw are correlated by the vehicle process model.  The measurement
+  // matrix below has no yaw coefficient, so any yaw correction is indirect.
+  covariance(0, 2) = 0.4;
+  covariance(2, 0) = 0.4;
+  TimeDelayKalmanFilter correlated_filter;
+  TimeDelayKalmanFilter masked_filter;
+  correlated_filter.init(state, covariance, 3, 2);
+  masked_filter.init(state, covariance, 3, 2);
+  ASSERT_EQ(correlated_filter.getExtendedStateDimension(), 20);
+  ASSERT_EQ(masked_filter.getExtendedStateDimension(), 20);
+
+  Eigen::MatrixXd measurement(2, 1);
+  measurement << 1.0, 0.0;
+  Eigen::MatrixXd measurement_matrix = Eigen::MatrixXd::Zero(2, 8);
+  measurement_matrix(0, 0) = 1.0;
+  measurement_matrix(1, 1) = 1.0;
+  measurement_matrix(0, 6) = 1.0;
+  measurement_matrix(1, 7) = 1.0;
+  ASSERT_DOUBLE_EQ(measurement_matrix(0, 2), 0.0);
+  ASSERT_DOUBLE_EQ(measurement_matrix(1, 2), 0.0);
+  const Eigen::MatrixXd measurement_covariance =
+    0.05 * Eigen::MatrixXd::Identity(2, 2);
+
+  ASSERT_TRUE(
+    correlated_filter.updateWithDelay(
+      measurement, measurement_matrix, measurement_covariance, 0));
+  Eigen::VectorXi mask = Eigen::VectorXi::Zero(8);
+  mask(0) = 1;
+  mask(1) = 1;
+  mask(6) = 1;
+  mask(7) = 1;
+  ASSERT_TRUE(
+    masked_filter.updateWithDelayStateMask(
+      measurement, measurement_matrix, measurement_covariance, 0, mask));
+
+  Eigen::MatrixXd correlated_state;
+  Eigen::MatrixXd masked_state;
+  correlated_filter.getX(correlated_state);
+  masked_filter.getX(masked_state);
+  EXPECT_GT(std::abs(correlated_state(2, 0)), 1.0e-3);
+  EXPECT_DOUBLE_EQ(masked_state(2, 0), 0.0);
+}
