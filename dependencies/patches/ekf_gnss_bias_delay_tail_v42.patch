+int TimeDelayKalmanFilter::delayedStateOffset(const int delay_step) const
+{
+  if (delay_step < 0 || delay_step >= max_delay_step_) {
+    throw std::out_of_range("delay step is outside the valid range");
+  }
+  return delay_step == 0
+           ? 0
+           : dim_x_ + (delay_step - 1) * delayed_state_size_;
+}
+
+double TimeDelayKalmanFilter::getDelayedXelement(
+  const int delay_step, const int state_index) const
+{
+  if (state_index < 0 || state_index >= dim_x_) {
+    throw std::out_of_range("state index is outside the valid range");
+  }
+  if (state_index >= delayed_state_size_) {
+    return x_(state_index, 0);
+  }
+  return x_(delayedStateOffset(delay_step) + state_index, 0);
+}
+
+Eigen::MatrixXd TimeDelayKalmanFilter::createExtendedMeasurementMatrix(
+  const Eigen::MatrixXd & C, const int delay_step) const
+{
+  if (C.cols() != dim_x_) {
+    return {};
+  }
+  Eigen::MatrixXd C_ex = Eigen::MatrixXd::Zero(C.rows(), dim_x_ex_);
+  C_ex.block(
+    0, delayedStateOffset(delay_step), C.rows(), delayed_state_size_) =
+    C.leftCols(delayed_state_size_);
+  if (non_delayed_tail_size_ > 0) {
+    C_ex.block(
+      0, delayed_state_size_, C.rows(), non_delayed_tail_size_) =
+      C.rightCols(non_delayed_tail_size_);
+  }
+  return C_ex;
+}
