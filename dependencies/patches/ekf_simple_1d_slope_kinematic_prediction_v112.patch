+TEST(Simple1DFilter, kinematic_prediction_moves_state_and_grows_covariance)
+{
+  Simple1DFilter filter;
+  filter.set_proc_var(25.0);
+  filter.init(100.0, 0.25);
+
+  filter.predict(0.02, 0.04);
+
+  EXPECT_DOUBLE_EQ(filter.get_x(), 100.04);
+  EXPECT_NEAR(filter.get_var(), 0.26, 1.0e-12);
+}
+
+TEST(Simple1DFilter, invalid_kinematic_prediction_is_a_noop)
+{
+  Simple1DFilter filter;
+  filter.set_proc_var(25.0);
+  filter.init(100.0, 0.25);
+
+  filter.predict(0.02, std::numeric_limits<double>::quiet_NaN());
+
+  EXPECT_DOUBLE_EQ(filter.get_x(), 100.0);
+  EXPECT_DOUBLE_EQ(filter.get_var(), 0.25);
