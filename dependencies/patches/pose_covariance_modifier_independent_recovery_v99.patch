+TEST(PoseCovarianceModifier, independent_xy_and_height_continue_after_initialized_ndt_times_out)
+{
+  ModifierHarness harness(
+    "ndt_primary_position", 0.05, 0.25, 3.0, false, 0.0, false, false, false,
+    0.5, 3, 0, true, 5.991464547107979, 13.815510557964274, 0.0, true);
+  auto gnss = harness.make_message(0.2, 0.05);
+  gnss.pose.pose.position.x += 0.25;
+  gnss.pose.pose.position.z += 0.10;
+
+  // GNSS never initializes the map-frame filter on its own.
+  harness.publish_gnss(gnss);
+  EXPECT_TRUE(harness.outputs().empty());
+
+  const auto ndt = harness.make_message(0.15, 0.20);
+  harness.publish_ndt(ndt);
+  harness.clear();
+  std::this_thread::sleep_for(70ms);
+  gnss.header.stamp = rclcpp::Time(ndt.header.stamp) + rclcpp::Duration::from_seconds(0.10);
+  harness.publish_gnss(gnss);
+
+  ASSERT_EQ(harness.outputs().size(), 2U);
+  EXPECT_EQ(harness.outputs()[0].pose.pose.position, gnss.pose.pose.position);
+  EXPECT_DOUBLE_EQ(harness.outputs()[0].pose.covariance[35], 1.0);
+  EXPECT_DOUBLE_EQ(harness.outputs()[1].pose.pose.position.x, ndt.pose.pose.position.x);
+  EXPECT_DOUBLE_EQ(harness.outputs()[1].pose.pose.position.y, ndt.pose.pose.position.y);
+  EXPECT_DOUBLE_EQ(harness.outputs()[1].pose.pose.position.z, gnss.pose.pose.position.z);
+  EXPECT_DOUBLE_EQ(harness.outputs()[1].pose.covariance[0], 1000000.0);
+  EXPECT_DOUBLE_EQ(harness.outputs()[1].pose.covariance[7], 1000000.0);
+  EXPECT_DOUBLE_EQ(harness.outputs()[1].pose.covariance[14], 0.1089);
+}
