+TEST(PositionOnlyInnovationMonitor, disabled_is_strict_no_op) {
+  PositionOnlyInnovationMonitor monitor;
+  for (std::int64_t sample = 1; sample <= 100; ++sample) {
+    const auto result = monitor.observe(Eigen::Vector2d(100.0, -100.0), 20000.0,
+                                        sample * 100000000);
+    EXPECT_FALSE(result.reject);
+    EXPECT_FALSE(result.latched);
