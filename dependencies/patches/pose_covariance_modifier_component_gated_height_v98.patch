+TEST(PoseCovarianceModifier, component_gated_height_publishes_independent_xy_and_z_measurements)
+{
+  ModifierHarness harness(
+    "ndt_primary_position", 1.0, 0.25, 3.0, false, 0.0, false, true, false,
+    2.0, 3, 2, true, 5.991464547107979, 13.815510557964274, 0.0, true);
+  auto ndt = harness.make_message(0.15, 0.20);
+  auto gnss = harness.make_message(0.20, 0.05, 15.0);
+  gnss.pose.pose.position.x += 0.1;
+  gnss.pose.pose.position.z += 0.1;
+  harness.publish_ndt(ndt);
+  harness.clear();
+  harness.publish_gnss(gnss);
+
+  ASSERT_EQ(harness.outputs().size(), 2U);
+  const auto & xy = harness.outputs()[0];
+  const auto & height = harness.outputs()[1];
+  EXPECT_EQ(xy.pose.pose.position, gnss.pose.pose.position);
+  EXPECT_DOUBLE_EQ(xy.pose.covariance[35], 1.0);
+  EXPECT_DOUBLE_EQ(height.pose.pose.position.x, ndt.pose.pose.position.x);
+  EXPECT_DOUBLE_EQ(height.pose.pose.position.y, ndt.pose.pose.position.y);
+  EXPECT_DOUBLE_EQ(height.pose.pose.position.z, gnss.pose.pose.position.z);
+  EXPECT_DOUBLE_EQ(height.pose.covariance[0], 1000000.0);
+  EXPECT_DOUBLE_EQ(height.pose.covariance[7], 1000000.0);
+  EXPECT_DOUBLE_EQ(height.pose.covariance[14], 0.1089);
+  EXPECT_EQ(height.pose.pose.orientation, ndt.pose.pose.orientation);
+}
