+bool is_height_only_pose_measurement(
+  const std::array<double, 36ul> & covariance, const bool feature_enabled,
+  const double xy_variance_threshold, const double z_variance_threshold,
+  const double yaw_variance_threshold)
+{
+  using COV_IDX = autoware_utils_geometry::xyzrpy_covariance_index::XYZRPY_COV_IDX;
+  const double x_variance = covariance.at(COV_IDX::X_X);
+  const double y_variance = covariance.at(COV_IDX::Y_Y);
+  const double z_variance = covariance.at(COV_IDX::Z_Z);
+  const double yaw_variance = covariance.at(COV_IDX::YAW_YAW);
+  return feature_enabled && std::isfinite(xy_variance_threshold) &&
+         xy_variance_threshold > 0.0 && std::isfinite(z_variance_threshold) &&
+         z_variance_threshold > 0.0 && std::isfinite(yaw_variance_threshold) &&
+         yaw_variance_threshold >= 0.0 && std::isfinite(x_variance) &&
+         std::isfinite(y_variance) && std::isfinite(z_variance) &&
+         std::isfinite(yaw_variance) && x_variance >= xy_variance_threshold &&
+         y_variance >= xy_variance_threshold && z_variance > 0.0 &&
+         z_variance <= z_variance_threshold && yaw_variance >= yaw_variance_threshold;
+}
