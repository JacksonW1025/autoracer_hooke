+TEST(PositionOnlyInnovationMonitor,
+     non_finite_input_fails_closed_when_enabled) {
+  PositionOnlyInnovationMonitorConfig config;
+  config.enabled = true;
+  PositionOnlyInnovationMonitor monitor(config);
+  const auto result = monitor.observe(
+      Eigen::Vector2d(std::numeric_limits<double>::quiet_NaN(), 0.0), 1.0,
+      100000000);
+  EXPECT_TRUE(result.reject);
+  EXPECT_TRUE(result.latched);
+}
