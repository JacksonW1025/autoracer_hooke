+      monitor.observe(Eigen::Vector2d(0.1, 0.0), 0.01, 200000000).reject);
+  const auto recovered =
+      monitor.observe(Eigen::Vector2d(0.1, 0.0), 0.01, 300000000);
+  EXPECT_FALSE(recovered.reject);
+  EXPECT_FALSE(recovered.latched);
+}
