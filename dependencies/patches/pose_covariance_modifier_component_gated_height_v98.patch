+  config.reference_sigma = 0.5;
+  config.decision_threshold = 3.0;
+  PositionOnlyInnovationMonitor monitor(config);
+
+  EXPECT_FALSE(
+      monitor.observe(Eigen::Vector2d(1.5, 0.0), 2.25, 100000000).reject);
+  EXPECT_FALSE(
+      monitor.observe(Eigen::Vector2d(1.5, 0.0), 2.25, 200000000).reject);
+  EXPECT_FALSE(
+      monitor.observe(Eigen::Vector2d(1.5, 0.0), 2.25, 300000000).reject);
+  EXPECT_FALSE(
+      monitor.observe(Eigen::Vector2d(1.5, 0.0), 2.25, 400000000).reject);
+  const auto trigger =
+      monitor.observe(Eigen::Vector2d(1.5, 0.0), 2.25, 500000000);
+  EXPECT_TRUE(trigger.reject);
+  EXPECT_TRUE(trigger.latched);
+  EXPECT_DOUBLE_EQ(trigger.statistic, 3.0);
+}
