+std::optional<double> PoseCovarianceModifierNode::gnss_ndt_height_reference(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg) const
+{
+  if (!ndt_pose_with_cov_last_) {
+    return std::nullopt;
+  }
+  double reference_z = ndt_pose_with_cov_last_->pose.pose.position.z;
+  if (gnss_ndt_motion_compensate_innovation_ && ndt_pose_with_cov_previous_) {
+    const rclcpp::Time previous_stamp(
+      ndt_pose_with_cov_previous_->header.stamp, this->get_clock()->get_clock_type());
+    const rclcpp::Time latest_stamp(
+      ndt_pose_with_cov_last_->header.stamp, this->get_clock()->get_clock_type());
+    const rclcpp::Time gnss_stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+    const double ndt_interval_sec = (latest_stamp - previous_stamp).seconds();
+    const double gnss_from_latest_sec = (gnss_stamp - latest_stamp).seconds();
+    if (
+      std::isfinite(ndt_interval_sec) && ndt_interval_sec > 1.0e-6 &&
+      std::isfinite(gnss_from_latest_sec)) {
+      const double velocity_z =
+        (ndt_pose_with_cov_last_->pose.pose.position.z -
+         ndt_pose_with_cov_previous_->pose.pose.position.z) /
+        ndt_interval_sec;
+      reference_z += velocity_z * gnss_from_latest_sec;
+    }
+  }
+  return std::isfinite(reference_z) ? std::optional<double>{reference_z} : std::nullopt;
+}
+
+void PoseCovarianceModifierNode::reset_trusted_height_outage_bridge()
+{
+  trusted_height_agreement_window_.clear();
+  trusted_height_outage_bridge_qualified_ = false;
+  trusted_height_previous_.reset();
+  trusted_height_last_.reset();
+}
+
+void PoseCovarianceModifierNode::observe_corroborated_gnss_height(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg, const bool agrees)
+{
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  const TimedHeight current{stamp.nanoseconds(), msg.pose.pose.position.z};
+  if (trusted_height_last_) {
+    const double gap_sec =
+      static_cast<double>(current.stamp_ns - trusted_height_last_->stamp_ns) * 1.0e-9;
+    if (
+      !std::isfinite(gap_sec) || gap_sec <= 0.0 ||
+      gap_sec > gnss_ndt_height_outage_reset_gap_sec_) {
+      reset_trusted_height_outage_bridge();
+    }
+  }
+  trusted_height_agreement_window_.push_back(agrees ? 1U : 0U);
+  while (
+    trusted_height_agreement_window_.size() >
+    static_cast<std::size_t>(gnss_ndt_height_outage_warmup_count_)) {
+    trusted_height_agreement_window_.pop_front();
+  }
+  const auto agreement_count = static_cast<int64_t>(std::count(
+      trusted_height_agreement_window_.begin(), trusted_height_agreement_window_.end(), 1U));
+  trusted_height_outage_bridge_qualified_ =
+    trusted_height_agreement_window_.size() ==
+      static_cast<std::size_t>(gnss_ndt_height_outage_warmup_count_) &&
+    agreement_count >= gnss_ndt_height_outage_minimum_agreement_count_;
+  trusted_height_previous_ = trusted_height_last_;
+  trusted_height_last_ = current;
+}
+
+bool PoseCovarianceModifierNode::trusted_height_outage_bridge_allows_gnss(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg,
+  const double gnss_pose_stddev_z)
+{
+  if (
+    !gnss_ndt_height_outage_bridge_enabled_ ||
+    !trusted_height_outage_bridge_qualified_ || !trusted_height_last_ ||
+    gnss_pose_stddev_z > threshold_gnss_stddev_z_max_) {
+    return false;
+  }
+  const double outage_age_sec = (this->now() - ndt_pose_received_time_last_).seconds();
+  if (
+    !std::isfinite(outage_age_sec) || outage_age_sec < 0.0 ||
+    outage_age_sec > gnss_ndt_height_outage_max_sec_) {
+    reset_trusted_height_outage_bridge();
+    return false;
+  }
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  const int64_t stamp_ns = stamp.nanoseconds();
+  const double gap_sec =
+    static_cast<double>(stamp_ns - trusted_height_last_->stamp_ns) * 1.0e-9;
+  if (
+    !std::isfinite(gap_sec) || gap_sec <= 0.0 ||
+    gap_sec > gnss_ndt_height_outage_reset_gap_sec_) {
+    reset_trusted_height_outage_bridge();
+    return false;
+  }
+  const double vertical_speed =
+    std::abs(msg.pose.pose.position.z - trusted_height_last_->z) / gap_sec;
+  if (
+    !std::isfinite(vertical_speed) ||
+    vertical_speed > gnss_ndt_height_outage_max_vertical_speed_mps_) {
+    reset_trusted_height_outage_bridge();
+    return false;
+  }
+  trusted_height_previous_ = trusted_height_last_;
+  trusted_height_last_ = TimedHeight{stamp_ns, msg.pose.pose.position.z};
+  return true;
+}
+
+bool PoseCovarianceModifierNode::gnss_height_is_trusted(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg,
+  const double gnss_pose_stddev_z)
+{
+  if (
+    !std::isfinite(gnss_pose_stddev_z) ||
+    gnss_pose_stddev_z > threshold_gnss_stddev_z_max_ ||
+    !has_valid_ndt_pose_ || !ndt_pose_with_cov_last_ ||
+    msg.header.frame_id != last_valid_ndt_frame_id_) {
+    return false;
+  }
+  bool sources_are_time_comparable = ndt_is_fresh();
+  if (sources_are_time_comparable && gnss_ndt_max_stamp_delta_sec_ > 0.0) {
+    const rclcpp::Time gnss_stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+    const rclcpp::Time ndt_stamp(
+      ndt_pose_with_cov_last_->header.stamp, this->get_clock()->get_clock_type());
+    const double stamp_delta_sec = std::abs((gnss_stamp - ndt_stamp).seconds());
+    sources_are_time_comparable =
+      std::isfinite(stamp_delta_sec) && stamp_delta_sec <= gnss_ndt_max_stamp_delta_sec_;
+  }
+  if (!sources_are_time_comparable) {
+    return !ndt_is_fresh() && trusted_height_outage_bridge_allows_gnss(
+      msg, gnss_pose_stddev_z);
+  }
+  const auto reference = gnss_ndt_height_reference(msg);
+  if (!reference) {
+    reset_trusted_height_outage_bridge();
+    return false;
+  }
+  const double innovation = msg.pose.pose.position.z - *reference;
+  const double innovation_variance =
+    msg.pose.covariance[Z_POS_IDX_] + ndt_pose_with_cov_last_->pose.covariance[Z_POS_IDX_];
+  if (
+    !std::isfinite(innovation) || !std::isfinite(innovation_variance) ||
+    innovation_variance <= 0.0) {
+    reset_trusted_height_outage_bridge();
+    return false;
+  }
+  const double nis = innovation * innovation / innovation_variance;
+  const bool agrees =
+    std::abs(innovation) <= gnss_ndt_height_innovation_max_m_ &&
+    std::isfinite(nis) && nis <= gnss_ndt_height_nis_hard_gate_;
+  if (gnss_ndt_height_outage_bridge_enabled_) {
+    observe_corroborated_gnss_height(msg, agrees);
+  }
+  return agrees;
+}
+
+void PoseCovarianceModifierNode::publish_position_only_measurement(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg)
+{
+  auto position_only = msg;
+  position_only.pose.pose.orientation = ndt_pose_with_cov_last_->pose.pose.orientation;
+  if (current_gnss_xy_covariance_scale_ > 1.0) {
+    for (const int index : {0, 1, 6, 7}) {
+      position_only.pose.covariance[index] *= current_gnss_xy_covariance_scale_;
+    }
+  }
+  for (int axis = 0; axis < 5; ++axis) {
+    position_only.pose.covariance[axis * 6 + 5] = 0.0;
+    position_only.pose.covariance[5 * 6 + axis] = 0.0;
+  }
+  position_only.pose.covariance[YAW_POS_IDX_] = gnss_position_only_yaw_variance_;
+  pub_pose_with_covariance_stamped_->publish(position_only);
+}
+
+void PoseCovarianceModifierNode::publish_height_only_measurement(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg)
+{
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  if (last_published_height_stamp_ns_) {
+    const double interval_sec =
+      static_cast<double>(stamp.nanoseconds() - *last_published_height_stamp_ns_) * 1.0e-9;
+    if (
+      !std::isfinite(interval_sec) || interval_sec < gnss_height_min_update_interval_sec_) {
+      return;
+    }
+  }
+  auto height_only = msg;
+  height_only.pose.pose.position.x = ndt_pose_with_cov_last_->pose.pose.position.x;
+  height_only.pose.pose.position.y = ndt_pose_with_cov_last_->pose.pose.position.y;
+  height_only.pose.pose.orientation = ndt_pose_with_cov_last_->pose.pose.orientation;
+  height_only.pose.covariance.fill(0.0);
+  height_only.pose.covariance[X_POS_IDX_] = gnss_height_disabled_variance_m2_;
+  height_only.pose.covariance[Y_POS_IDX_] = gnss_height_disabled_variance_m2_;
+  height_only.pose.covariance[Z_POS_IDX_] =
+    std::max(msg.pose.covariance[Z_POS_IDX_], gnss_height_variance_floor_m2_);
+  height_only.pose.covariance[21] = gnss_height_disabled_variance_m2_;
+  height_only.pose.covariance[28] = gnss_height_disabled_variance_m2_;
+  height_only.pose.covariance[YAW_POS_IDX_] = gnss_position_only_yaw_variance_;
+  pub_pose_with_covariance_stamped_->publish(height_only);
+  last_published_height_stamp_ns_ = stamp.nanoseconds();
+}
