+TEST(PoseCovarianceModifier, gnss_subscription_depth_defaults_to_official_ten)
+{
+  ModifierHarness harness("official");
+  EXPECT_EQ(harness.gnss_subscription_qos_depth(), 10);
+}
+
+TEST(PoseCovarianceModifier, gnss_subscription_depth_must_be_positive)
+{
+  EXPECT_THROW(ModifierHarness(0), std::invalid_argument);
+}
+
+TEST(PoseCovarianceModifier, depth_one_discards_stale_gnss_backlog_and_keeps_latest)
+{
+  ModifierHarness harness(1);
+  EXPECT_EQ(harness.gnss_subscription_qos_depth(), 1);
+
+  const auto ndt = harness.make_message(0.15);
+  harness.publish_ndt(ndt);
+  harness.clear();
+
+  for (int index = 0; index < 10; ++index) {
+    auto gnss = harness.make_message(0.1);
+    gnss.pose.pose.position.x = 20.0 + static_cast<double>(index);
+    harness.publish_gnss_without_spinning(gnss);
+  }
+  harness.flush();
+
+  ASSERT_EQ(harness.outputs().size(), 1U);
+  EXPECT_DOUBLE_EQ(harness.outputs().front().pose.pose.position.x, 29.0);
+}
