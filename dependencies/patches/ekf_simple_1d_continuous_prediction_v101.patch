+#include "autoware/ekf_localizer/ekf_module.hpp"
+
+#include <gtest/gtest.h>
+
+namespace autoware::ekf_localizer
+{
+
+TEST(Simple1DFilter, split_predict_and_correct_is_equivalent_to_legacy_update)
+{
+  Simple1DFilter legacy;
+  Simple1DFilter split;
+  legacy.set_proc_var(25.0);
+  split.set_proc_var(25.0);
+  legacy.init(1.0, 0.2);
+  split.init(1.0, 0.2);
+
+  legacy.update(1.3, 0.4, 0.02);
+  split.predict(0.02);
+  split.correct(1.3, 0.4);
+
+  EXPECT_DOUBLE_EQ(split.get_x(), legacy.get_x());
+  EXPECT_DOUBLE_EQ(split.get_var(), legacy.get_var());
+}
+
+TEST(Simple1DFilter, covariance_grows_on_every_predict_tick_without_measurement)
+{
+  Simple1DFilter filter;
+  filter.set_proc_var(25.0);
+  filter.init(0.0, 0.1089);
+  for (int i = 0; i < 2300; ++i) {
+    filter.predict(0.02);
+  }
+
+  EXPECT_NEAR(filter.get_var(), 23.1089, 1.0e-9);
+  const double recovery_nis = 10.0 * 10.0 / (filter.get_var() + 0.1089);
+  EXPECT_LT(recovery_nis, 10.827566170662733);
+}
+
+TEST(Simple1DFilter, multiple_measurements_in_one_predict_tick_do_not_duplicate_process_noise)
+{
+  Simple1DFilter filter;
+  filter.set_proc_var(25.0);
+  filter.init(0.0, 0.25);
+
+  filter.predict(0.02);
+  filter.correct(0.1, 0.5);
+  const double variance_after_first_correction = filter.get_var();
+  filter.correct(0.2, 0.5);
+
+  EXPECT_LT(filter.get_var(), variance_after_first_correction);
+  EXPECT_GT(filter.get_x(), 0.0);
+  EXPECT_LT(filter.get_x(), 0.2);
+}
+
+TEST(Simple1DFilter, prediction_before_initialization_is_a_noop)
+{
+  Simple1DFilter filter;
+  filter.set_proc_var(25.0);
+  filter.predict(10.0);
+  EXPECT_FALSE(filter.is_initialized());
+  EXPECT_DOUBLE_EQ(filter.get_var(), 1.0e9);
+}
+
+}  // namespace autoware::ekf_localizer
