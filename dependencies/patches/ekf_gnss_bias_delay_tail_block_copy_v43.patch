+TEST(time_delay_kalman_filter, compact_tail_prediction_matches_explicit_transition)
+{
+  constexpr int state_dimension = 4;
+  constexpr int delayed_dimension = 3;
+  constexpr int delay_steps = 3;
+  constexpr int extended_dimension =
+    state_dimension + delayed_dimension * (delay_steps - 1);
+  Eigen::MatrixXd state(state_dimension, 1);
+  state << 1.0, -2.0, 0.5, 0.25;
+  Eigen::MatrixXd basis = Eigen::MatrixXd::Random(
+    state_dimension, state_dimension);
+  const Eigen::MatrixXd covariance =
+    basis * basis.transpose() +
+    0.1 * Eigen::MatrixXd::Identity(state_dimension, state_dimension);
+  TimeDelayKalmanFilter filter;
+  filter.init(state, covariance, delay_steps, 1);
+
+  Eigen::MatrixXd transition =
+    Eigen::MatrixXd::Identity(state_dimension, state_dimension);
+  transition(0, 2) = 0.2;
+  transition(1, 3) = -0.1;
+  const Eigen::MatrixXd process_noise =
+    0.01 * Eigen::MatrixXd::Identity(state_dimension, state_dimension);
+  const Eigen::MatrixXd predicted = transition * state;
+
+  Eigen::MatrixXd previous_state;
+  Eigen::MatrixXd previous_covariance;
+  filter.getX(previous_state);
+  filter.getP(previous_covariance);
+  Eigen::MatrixXd extended_transition =
+    Eigen::MatrixXd::Zero(extended_dimension, extended_dimension);
+  extended_transition.block(
+    0, 0, state_dimension, state_dimension) = transition;
+  extended_transition.block(
+    state_dimension, 0, delayed_dimension, delayed_dimension) =
+    Eigen::MatrixXd::Identity(delayed_dimension, delayed_dimension);
+  extended_transition.block(
+    state_dimension + delayed_dimension, state_dimension,
+    delayed_dimension, delayed_dimension) =
+    Eigen::MatrixXd::Identity(delayed_dimension, delayed_dimension);
+  Eigen::MatrixXd expected_state =
+    extended_transition * previous_state;
+  expected_state.topRows(state_dimension) = predicted;
+  Eigen::MatrixXd expected_covariance =
+    extended_transition * previous_covariance *
+    extended_transition.transpose();
+  expected_covariance.topLeftCorner(
+    state_dimension, state_dimension) += process_noise;
+
+  ASSERT_TRUE(
+    filter.predictWithDelay(predicted, transition, process_noise));
+  Eigen::MatrixXd actual_state;
+  Eigen::MatrixXd actual_covariance;
+  filter.getX(actual_state);
+  filter.getP(actual_covariance);
+  EXPECT_TRUE(actual_state.isApprox(expected_state, 1.0e-12));
+  EXPECT_TRUE(actual_covariance.isApprox(expected_covariance, 1.0e-12));
+}
