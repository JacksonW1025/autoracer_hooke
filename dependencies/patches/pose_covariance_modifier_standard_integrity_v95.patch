+std::optional<double> PoseCovarianceModifierNode::gnss_ndt_xy_nis(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg) const
+{
+  const auto reference = gnss_ndt_xy_reference(msg);
+  if (!reference || !ndt_pose_with_cov_last_) {
+    return std::nullopt;
+  }
+
+  // For two independent position observations, the innovation covariance is
+  // S = R_gnss + R_ndt.  Use the complete symmetric XY blocks so correlated
+  // horizontal errors are handled without changing either source covariance.
+  const auto & gnss_covariance = msg.pose.covariance;
+  const auto & ndt_covariance = ndt_pose_with_cov_last_->pose.covariance;
+  const double s_xx = gnss_covariance[0] + ndt_covariance[0];
+  const double s_xy = gnss_covariance[1] + ndt_covariance[1];
+  const double s_yx = gnss_covariance[6] + ndt_covariance[6];
+  const double s_yy = gnss_covariance[7] + ndt_covariance[7];
+  const double covariance_scale = std::max({1.0, std::abs(s_xx), std::abs(s_yy)});
+  if (
+    !std::isfinite(s_xx) || !std::isfinite(s_xy) || !std::isfinite(s_yx) ||
+    !std::isfinite(s_yy) ||
+    std::abs(s_xy - s_yx) > 1.0e-9 * covariance_scale) {
+    return std::nullopt;
+  }
+  const double determinant = s_xx * s_yy - s_xy * s_yx;
+  if (!std::isfinite(determinant) || determinant <= 0.0) {
+    return std::nullopt;
+  }
+
+  const double delta_x = msg.pose.pose.position.x - (*reference)[0];
+  const double delta_y = msg.pose.pose.position.y - (*reference)[1];
+  const double nis =
+    (s_yy * delta_x * delta_x - (s_xy + s_yx) * delta_x * delta_y +
+     s_xx * delta_y * delta_y) /
+    determinant;
+  if (!std::isfinite(nis) || nis < -1.0e-12) {
+    return std::nullopt;
+  }
+  return std::max(0.0, nis);
+}
