+bool PoseCovarianceModifierNode::trusted_outage_bridge_allows_gnss(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg,
+  const double gnss_pose_stddev_xy)
+{
+  if (!trusted_outage_bridge_qualified_ || !trusted_outage_gnss_last_) {
+    return false;
+  }
+
+  const double outage_age_sec = (this->now() - ndt_pose_received_time_last_).seconds();
+  if (
+    !std::isfinite(outage_age_sec) || outage_age_sec < 0.0 ||
+    outage_age_sec > gnss_ndt_trusted_outage_max_sec_) {
+    reset_trusted_outage_bridge();
+    return false;
+  }
+
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  const TimedXyPosition current{
+    stamp.nanoseconds(), msg.pose.pose.position.x, msg.pose.pose.position.y};
+  const double current_interval_sec =
+    static_cast<double>(current.stamp_ns - trusted_outage_gnss_last_->stamp_ns) * 1.0e-9;
+  if (
+    !std::isfinite(current_interval_sec) || current_interval_sec <= 0.0 ||
+    current_interval_sec > gnss_ndt_trusted_outage_reset_gap_sec_) {
+    reset_trusted_outage_bridge();
+    return false;
+  }
+
+  if (trusted_outage_gnss_previous_) {
+    const double previous_interval_sec = static_cast<double>(
+      trusted_outage_gnss_last_->stamp_ns - trusted_outage_gnss_previous_->stamp_ns) * 1.0e-9;
+    if (!std::isfinite(previous_interval_sec) || previous_interval_sec <= 0.0) {
+      reset_trusted_outage_bridge();
+      return false;
+    }
+    const double ratio = current_interval_sec / previous_interval_sec;
+    const double predicted_x = trusted_outage_gnss_last_->x +
+      ratio * (trusted_outage_gnss_last_->x - trusted_outage_gnss_previous_->x);
+    const double predicted_y = trusted_outage_gnss_last_->y +
+      ratio * (trusted_outage_gnss_last_->y - trusted_outage_gnss_previous_->y);
+    const double prediction_error_m =
+      std::hypot(current.x - predicted_x, current.y - predicted_y);
+    if (
+      !std::isfinite(prediction_error_m) ||
+      prediction_error_m > gnss_ndt_trusted_outage_prediction_error_max_m_) {
+      reset_trusted_outage_bridge();
+      return false;
+    }
+  }
+
+  const double added_uncertainty_m =
+    gnss_ndt_trusted_outage_uncertainty_growth_m_per_sec_ * outage_age_sec;
+  const double covariance_scale_reference_m =
+    std::max(gnss_pose_stddev_xy, threshold_gnss_stddev_xy_bound_lower_);
+  current_gnss_xy_covariance_scale_ = std::max(
+    1.0,
+    1.0 + std::pow(added_uncertainty_m / covariance_scale_reference_m, 2));
+  trusted_outage_gnss_previous_ = trusted_outage_gnss_last_;
+  trusted_outage_gnss_last_ = current;
   return true;
 }
 
