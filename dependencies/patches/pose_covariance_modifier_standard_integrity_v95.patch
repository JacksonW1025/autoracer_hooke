+void PoseCovarianceModifierNode::reset_trusted_outage_bridge()
+{
+  trusted_outage_agreement_count_ = 0;
+  trusted_outage_agreement_window_.clear();
+  trusted_outage_bridge_qualified_ = false;
+  trusted_outage_gnss_previous_.reset();
+  trusted_outage_gnss_last_.reset();
+}
+
+void PoseCovarianceModifierNode::observe_corroborated_gnss_for_outage_bridge(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg, const double innovation_m,
+  const std::optional<double> & cross_source_nis)
+{
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  const TimedXyPosition current{
+    stamp.nanoseconds(), msg.pose.pose.position.x, msg.pose.pose.position.y};
+
+  if (trusted_outage_gnss_last_) {
+    const double gap_sec =
+      static_cast<double>(current.stamp_ns - trusted_outage_gnss_last_->stamp_ns) * 1.0e-9;
+    if (
+      !std::isfinite(gap_sec) || gap_sec <= 0.0 ||
+      gap_sec > gnss_ndt_trusted_outage_reset_gap_sec_) {
+      reset_trusted_outage_bridge();
+    }
+  }
+
+  const bool agrees_with_ndt = gnss_ndt_trusted_outage_agreement_nis_ > 0.0
+    ? cross_source_nis && *cross_source_nis <= gnss_ndt_trusted_outage_agreement_nis_
+    : innovation_m <= gnss_ndt_trusted_outage_agreement_m_;
+  const uint8_t agrees = agrees_with_ndt ? 1U : 0U;
+  trusted_outage_agreement_window_.push_back(agrees);
+  trusted_outage_agreement_count_ += agrees;
+  while (
+    trusted_outage_agreement_window_.size() >
+    static_cast<std::size_t>(gnss_ndt_trusted_outage_warmup_count_)) {
+    trusted_outage_agreement_count_ -= trusted_outage_agreement_window_.front();
+    trusted_outage_agreement_window_.pop_front();
+  }
+  trusted_outage_bridge_qualified_ =
+    trusted_outage_agreement_window_.size() ==
+      static_cast<std::size_t>(gnss_ndt_trusted_outage_warmup_count_) &&
+    trusted_outage_agreement_count_ >=
+      gnss_ndt_trusted_outage_minimum_agreement_count_;
+
+  trusted_outage_gnss_previous_ = trusted_outage_gnss_last_;
+  trusted_outage_gnss_last_ = current;
+}
