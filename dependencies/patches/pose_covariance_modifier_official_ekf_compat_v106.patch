   auto position_only = msg;
+  // The stock Autoware EKF consumes one PoseWithCovariance stream and has no
+  // separate GNSS-position topic.  Preserve the receiver's x/y observation,
+  // but explicitly make z/roll/pitch/yaw non-observations.  Copying their
+  // values from the time-aligned NDT sample avoids a synthetic residual; the
+  // very large diagonal variances make their Kalman information negligible.
+  // This keeps the official EKF mathematics untouched while implementing the
+  // conventional H=[x,y] loose-coupling semantics at the message boundary.
+  position_only.pose.pose.position.z = ndt_pose_with_cov_last_->pose.pose.position.z;
   position_only.pose.pose.orientation = ndt_pose_with_cov_last_->pose.pose.orientation;
   if (current_gnss_xy_covariance_scale_ > 1.0) {
     for (const int index : {0, 1, 6, 7}) {
