+TEST(StateTransition, gnss_bias_extension_preserves_vehicle_model)
+{
+  Eigen::VectorXd x = Eigen::VectorXd::Zero(8);
+  x.head<6>() = (Vector6d() << 2.0, 3.0, 0.3, 0.1, 5.0, 0.2).finished();
+  x(IDX::GNSS_BX) = 0.4;
+  x(IDX::GNSS_BY) = -0.2;
+  constexpr double dt = 0.02;
+  constexpr double decay = 0.996;
+
+  const Eigen::VectorXd next = predict_next_state_with_gnss_bias(x, dt, decay);
+  EXPECT_EQ((next.head<6>() - predict_next_state(x.head<6>(), dt)).norm(), 0.0);
+  EXPECT_DOUBLE_EQ(next(IDX::GNSS_BX), decay * x(IDX::GNSS_BX));
+  EXPECT_DOUBLE_EQ(next(IDX::GNSS_BY), decay * x(IDX::GNSS_BY));
+
+  const Eigen::MatrixXd a =
+    create_state_transition_matrix_with_gnss_bias(x, dt, decay);
+  EXPECT_EQ(
+    (a.topLeftCorner<6, 6>() - create_state_transition_matrix(x.head<6>(), dt)).norm(),
+    0.0);
+  EXPECT_DOUBLE_EQ(a(IDX::GNSS_BX, IDX::GNSS_BX), decay);
+  EXPECT_DOUBLE_EQ(a(IDX::GNSS_BY, IDX::GNSS_BY), decay);
+}
