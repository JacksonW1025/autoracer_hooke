+TEST(StateTransition, gnss_bias_process_keeps_requested_stationary_variance)
+{
+  constexpr double stationary_variance = 0.04;
+  constexpr double decay = 0.9;
+  constexpr double process_variance = stationary_variance * (1.0 - decay * decay);
+  const Eigen::MatrixXd q =
+    process_noise_covariance_with_gnss_bias(1.0, 2.0, 3.0, process_variance);
+  EXPECT_DOUBLE_EQ(q(IDX::GNSS_BX, IDX::GNSS_BX), process_variance);
+  EXPECT_DOUBLE_EQ(q(IDX::GNSS_BY, IDX::GNSS_BY), process_variance);
+  EXPECT_DOUBLE_EQ(
+    decay * decay * stationary_variance + q(IDX::GNSS_BX, IDX::GNSS_BX),
+    stationary_variance);
+}
