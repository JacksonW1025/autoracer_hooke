+TEST(GnssBiasState, repeated_correlated_fix_is_separated_from_vehicle_position)
+{
+  autoware::kalman_filter::KalmanFilter filter;
+  Eigen::VectorXd state = Eigen::VectorXd::Zero(8);
+  Eigen::MatrixXd covariance = Eigen::MatrixXd::Identity(8, 8);
+  covariance(IDX::X, IDX::X) = 0.04;
+  covariance(IDX::Y, IDX::Y) = 0.04;
+  covariance(IDX::GNSS_BX, IDX::GNSS_BX) = 0.18407490243154828 * 0.18407490243154828;
+  covariance(IDX::GNSS_BY, IDX::GNSS_BY) = 0.18407490243154828 * 0.18407490243154828;
+  ASSERT_TRUE(filter.init(state, covariance));
+
+  constexpr double dt = 0.02;
+  constexpr double tau = 5.0;
+  constexpr double sigma = 0.18407490243154828;
+  const double decay = std::exp(-dt / tau);
+  const double bias_q = sigma * sigma * (1.0 - decay * decay);
+  const Eigen::MatrixXd ndt_h = pose_measurement_matrix(8);
+  const Eigen::MatrixXd gnss_h = position_only_pose_measurement_matrix(8, true);
+  const Eigen::Vector3d ndt = Eigen::Vector3d::Zero();
+  const Eigen::Vector2d gnss(0.20, -0.15);
+  const Eigen::Matrix3d ndt_r = Eigen::Matrix3d::Identity() * 0.01;
+  const Eigen::Matrix2d gnss_r = Eigen::Matrix2d::Identity() * 0.01;
+
+  for (int i = 0; i < 500; ++i) {
+    Eigen::MatrixXd current;
+    filter.getX(current);
+    const Eigen::VectorXd next =
+      predict_next_state_with_gnss_bias(current, dt, decay);
+    const Eigen::MatrixXd a =
+      create_state_transition_matrix_with_gnss_bias(current, dt, decay);
+    const Eigen::MatrixXd q =
+      process_noise_covariance_with_gnss_bias(0.0, 0.0, 0.0, bias_q);
+    ASSERT_TRUE(filter.predict(next, a, q));
+    ASSERT_TRUE(filter.update(ndt, ndt_h, ndt_r));
+    ASSERT_TRUE(filter.update(gnss, gnss_h, gnss_r));
+  }
+
+  Eigen::MatrixXd state_matrix;
+  filter.getX(state_matrix);
+  state = state_matrix;
+  EXPECT_LT(std::abs(state(IDX::X)), 0.08);
+  EXPECT_LT(std::abs(state(IDX::Y)), 0.08);
+  EXPECT_GT(state(IDX::GNSS_BX), 0.08);
+  EXPECT_LT(state(IDX::GNSS_BY), -0.05);
+  EXPECT_NEAR(
+    state(IDX::X) + state(IDX::GNSS_BX), gnss.x(), 0.08);
+  EXPECT_NEAR(
+    state(IDX::Y) + state(IDX::GNSS_BY), gnss.y(), 0.08);
+}
+
+TEST(GnssBiasState, gnss_dropout_does_not_leave_bias_in_vehicle_output)
+{
+  autoware::kalman_filter::KalmanFilter filter;
+  Eigen::VectorXd state = Eigen::VectorXd::Zero(8);
+  state(IDX::GNSS_BX) = 0.3;
+  state(IDX::GNSS_BY) = -0.2;
+  Eigen::MatrixXd covariance = Eigen::MatrixXd::Identity(8, 8) * 0.01;
+  ASSERT_TRUE(filter.init(state, covariance));
+
+  constexpr double dt = 0.02;
+  constexpr double tau = 5.0;
+  const double decay = std::exp(-dt / tau);
+  const Eigen::MatrixXd ndt_h = pose_measurement_matrix(8);
+  const Eigen::Vector3d ndt = Eigen::Vector3d::Zero();
+  const Eigen::Matrix3d ndt_r = Eigen::Matrix3d::Identity() * 0.01;
+  for (int i = 0; i < 500; ++i) {
+    Eigen::MatrixXd current;
+    filter.getX(current);
+    ASSERT_TRUE(filter.predict(
+      predict_next_state_with_gnss_bias(current, dt, decay),
+      create_state_transition_matrix_with_gnss_bias(current, dt, decay),
+      process_noise_covariance_with_gnss_bias(0.0, 0.0, 0.0, 0.0)));
+    ASSERT_TRUE(filter.update(ndt, ndt_h, ndt_r));
+  }
+
+  Eigen::MatrixXd state_matrix;
+  filter.getX(state_matrix);
+  state = state_matrix;
+  EXPECT_NEAR(state(IDX::X), 0.0, 1.0e-9);
+  EXPECT_NEAR(state(IDX::Y), 0.0, 1.0e-9);
+  EXPECT_LT(std::abs(state(IDX::GNSS_BX)), 0.3);
+  EXPECT_LT(std::abs(state(IDX::GNSS_BY)), 0.2);
+}
