+Eigen::VectorXd predict_next_state_with_gnss_bias(
+  const Eigen::VectorXd & x_curr, const double dt, const double bias_decay)
+{
+  Eigen::VectorXd x_next = Eigen::VectorXd::Zero(8);
+  // Keep the well-tested six-state motion model as the single source of
+  // vehicle-state truth; only the two bias states are added here.
+  x_next.head<6>() = predict_next_state(x_curr.head<6>(), dt);
+  x_next(IDX::GNSS_BX) = bias_decay * x_curr(IDX::GNSS_BX);
+  x_next(IDX::GNSS_BY) = bias_decay * x_curr(IDX::GNSS_BY);
+  return x_next;
+}
+
+Eigen::MatrixXd create_state_transition_matrix_with_gnss_bias(
+  const Eigen::VectorXd & x_curr, const double dt, const double bias_decay)
+{
+  Eigen::MatrixXd a = Eigen::MatrixXd::Identity(8, 8);
+  a.topLeftCorner<6, 6>() = create_state_transition_matrix(x_curr.head<6>(), dt);
+  a(IDX::GNSS_BX, IDX::GNSS_BX) = bias_decay;
+  a(IDX::GNSS_BY, IDX::GNSS_BY) = bias_decay;
+  return a;
+}
+
+Eigen::MatrixXd process_noise_covariance_with_gnss_bias(
+  const double proc_cov_yaw_d, const double proc_cov_vx_d, const double proc_cov_wz_d,
+  const double bias_process_covariance)
+{
+  Eigen::MatrixXd q = Eigen::MatrixXd::Zero(8, 8);
+  q.topLeftCorner<6, 6>() =
+    process_noise_covariance(proc_cov_yaw_d, proc_cov_vx_d, proc_cov_wz_d);
+  q(IDX::GNSS_BX, IDX::GNSS_BX) = bias_process_covariance;
+  q(IDX::GNSS_BY, IDX::GNSS_BY) = bias_process_covariance;
+  return q;
+}
