+TEST(PoseCovarianceModifier, ndt_primary_position_accepts_gnss_after_initialized_ndt_times_out)
+{
+  ModifierHarness harness("ndt_primary_position", 0.05, 0.25, 3.0);
+  auto ndt = harness.make_message(0.15);
+  ndt.pose.pose.orientation.z = std::sin(M_PI / 8.0);
+  ndt.pose.pose.orientation.w = std::cos(M_PI / 8.0);
+  harness.publish_ndt(ndt);
+  harness.clear();
+
+  std::this_thread::sleep_for(70ms);
+  auto gnss = harness.make_message(0.2);
+  gnss.pose.pose.position.x += 0.25;
+  harness.publish_gnss(gnss);
+
+  ASSERT_EQ(harness.outputs().size(), 1U);
+  EXPECT_EQ(harness.outputs().front().pose.pose.position, gnss.pose.pose.position);
+  EXPECT_EQ(harness.outputs().front().pose.pose.orientation, ndt.pose.pose.orientation);
+}
