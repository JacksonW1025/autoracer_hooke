+  harness.publish_ndt(ndt);
+  harness.clear();
+  harness.publish_gnss(harness.make_message(0.250001));
+  EXPECT_TRUE(harness.outputs().empty());
+}
+
+TEST(PoseCovarianceModifier, ndt_primary_position_rejects_large_ndt_innovation)
+{
+  ModifierHarness harness("ndt_primary_position", 1.0, 0.25, 3.0);
+  const auto ndt = harness.make_message(0.15);
+  harness.publish_ndt(ndt);
+  harness.clear();
+
+  auto false_fix = harness.make_message(0.1);
+  false_fix.pose.pose.position.x += 5.0;
+  harness.publish_gnss(false_fix);
+  EXPECT_TRUE(harness.outputs().empty());
+
+  auto normal_fix = harness.make_message(0.1);
+  normal_fix.pose.pose.position.x += 0.5;
+  harness.publish_gnss(normal_fix);
+  ASSERT_EQ(harness.outputs().size(), 1U);
+  EXPECT_EQ(harness.outputs().front().pose.pose.position, normal_fix.pose.pose.position);
+}
