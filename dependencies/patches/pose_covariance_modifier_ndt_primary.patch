+bool PoseCovarianceModifierNode::pose_message_is_valid(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg, const char * source) const
+{
+  const auto & p = msg.pose.pose.position;
+  const auto & q = msg.pose.pose.orientation;
+  if (
+    msg.header.frame_id.empty() || !std::isfinite(p.x) || !std::isfinite(p.y) ||
+    !std::isfinite(p.z) || !std::isfinite(q.x) || !std::isfinite(q.y) ||
+    !std::isfinite(q.z) || !std::isfinite(q.w)) {
+    RCLCPP_WARN(this->get_logger(), "%s pose contains an invalid frame or non-finite pose", source);
+    return false;
+  }
+
+  const double quaternion_norm_squared = q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w;
+  if (!std::isfinite(quaternion_norm_squared) || quaternion_norm_squared <= 1.0e-12) {
+    RCLCPP_WARN(this->get_logger(), "%s pose contains an invalid quaternion", source);
+    return false;
+  }
+
+  for (const double value : msg.pose.covariance) {
+    if (!std::isfinite(value)) {
+      RCLCPP_WARN(this->get_logger(), "%s covariance contains a non-finite value", source);
+      return false;
+    }
+  }
+  for (const int index : {X_POS_IDX_, Y_POS_IDX_, Z_POS_IDX_, YAW_POS_IDX_}) {
+    if (msg.pose.covariance[index] <= 0.0) {
+      RCLCPP_WARN(this->get_logger(), "%s covariance has a non-positive diagonal", source);
+      return false;
+    }
+  }
+  return true;
+}
+
+bool PoseCovarianceModifierNode::message_stamp_is_fresh(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg, const char * source) const
+{
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  if (stamp.nanoseconds() <= 0) {
+    RCLCPP_WARN(this->get_logger(), "%s pose has an invalid zero timestamp", source);
+    return false;
+  }
+  const double age_sec = (this->now() - stamp).seconds();
+  if (!std::isfinite(age_sec) || age_sec > gnss_pose_timeout_sec_ || age_sec < -gnss_pose_timeout_sec_) {
+    RCLCPP_WARN(this->get_logger(), "%s pose timestamp is outside the freshness window", source);
+    return false;
+  }
+  return true;
+}
+
+bool PoseCovarianceModifierNode::ndt_is_fresh() const
+{
+  if (!has_valid_ndt_pose_) {
+    return false;
+  }
+  const double age_sec = (this->now() - ndt_pose_received_time_last_).seconds();
+  return std::isfinite(age_sec) && age_sec >= 0.0 && age_sec <= gnss_pose_timeout_sec_;
+}
+
+bool PoseCovarianceModifierNode::gnss_is_trusted(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg,
+  const double gnss_pose_yaw_stddev_deg, const double gnss_pose_stddev_z,
+  const double gnss_pose_stddev_xy) const
+{
+  if (!ndt_is_fresh()) {
+    RCLCPP_WARN(this->get_logger(), "GNSS pose rejected because no fresh valid NDT pose exists");
+    return false;
+  }
+  if (msg.header.frame_id != last_valid_ndt_frame_id_) {
+    RCLCPP_WARN(this->get_logger(), "GNSS pose rejected because its frame differs from NDT");
+    return false;
+  }
+  return gnss_pose_yaw_stddev_deg <= threshold_gnss_stddev_yaw_deg_max_ &&
+         gnss_pose_stddev_z <= threshold_gnss_stddev_z_max_ &&
+         gnss_pose_stddev_xy <= threshold_gnss_stddev_xy_bound_upper_;
+}
+
+bool PoseCovarianceModifierNode::gnss_position_is_trusted(
+  const geometry_msgs::msg::PoseWithCovarianceStamped & msg,
+  const double gnss_pose_stddev_xy) const
+{
+  if (!ndt_is_fresh() || !ndt_pose_with_cov_last_) {
+    RCLCPP_WARN(this->get_logger(), "GNSS position rejected because no fresh valid NDT pose exists");
+    return false;
+  }
+  if (msg.header.frame_id != last_valid_ndt_frame_id_) {
+    RCLCPP_WARN(this->get_logger(), "GNSS position rejected because its frame differs from NDT");
+    return false;
+  }
+  if (gnss_ndt_max_stamp_delta_sec_ > 0.0) {
+    const rclcpp::Time gnss_stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+    const rclcpp::Time ndt_stamp(
+      ndt_pose_with_cov_last_->header.stamp, this->get_clock()->get_clock_type());
+    const double stamp_delta_sec = std::abs((gnss_stamp - ndt_stamp).seconds());
+    if (
+      !std::isfinite(stamp_delta_sec) ||
+      stamp_delta_sec > gnss_ndt_max_stamp_delta_sec_) {
+      RCLCPP_WARN(this->get_logger(), "GNSS position rejected because NDT is not timestamp-close");
+      return false;
+    }
+  }
+  if (gnss_ndt_xy_innovation_max_m_ > 0.0) {
+    const double dx =
+      msg.pose.pose.position.x - ndt_pose_with_cov_last_->pose.pose.position.x;
+    const double dy =
+      msg.pose.pose.position.y - ndt_pose_with_cov_last_->pose.pose.position.y;
+    const double innovation_m = std::hypot(dx, dy);
+    if (
+      !std::isfinite(innovation_m) ||
+      innovation_m > gnss_ndt_xy_innovation_max_m_) {
+      RCLCPP_WARN(this->get_logger(), "GNSS position rejected by the NDT innovation gate");
+      return false;
+    }
+  }
+  return gnss_pose_stddev_xy <= threshold_gnss_stddev_xy_bound_upper_;
+}
