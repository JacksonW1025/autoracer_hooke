+bool KalmanFilter::updateWithStateMask(
+  const Eigen::MatrixXd & y, const Eigen::MatrixXd & C, const Eigen::MatrixXd & R,
+  const Eigen::VectorXi & state_update_mask, const double selected_state_variance_floor,
