+
+bool TimeDelayKalmanFilter::updateWithDelayStateMask(
+  const Eigen::MatrixXd & y, const Eigen::MatrixXd & C, const Eigen::MatrixXd & R,
+  const int delay_step, const Eigen::VectorXi & state_update_mask,
+  const double selected_state_variance_floor, const bool decorrelate_selected_states)
+{
+  if (delay_step >= max_delay_step_ || delay_step < 0) {
+    std::cerr << "delay step is outside the valid range. ignore update." << std::endl;
+    return false;
+  }
+  if (state_update_mask.rows() != dim_x_) {
+    std::cerr << "state update mask dimension differs from latest state. ignore update."
+              << std::endl;
+    return false;
+  }
+
+  const int dim_y = y.rows();
+  Eigen::MatrixXd C_ex = Eigen::MatrixXd::Zero(dim_y, dim_x_ex_);
+  C_ex.block(0, dim_x_ * delay_step, dim_y, dim_x_) = C;
+
+  Eigen::VectorXi state_update_mask_ex(dim_x_ex_);
+  for (int step = 0; step < max_delay_step_; ++step) {
+    state_update_mask_ex.segment(step * dim_x_, dim_x_) = state_update_mask;
+  }
+  return updateWithStateMask(
+    y, C_ex, R, state_update_mask_ex, selected_state_variance_floor,
+    decorrelate_selected_states);
+}
