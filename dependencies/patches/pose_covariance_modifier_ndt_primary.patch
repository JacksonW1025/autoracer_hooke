+class ModifierHarness
+{
+public:
+  ModifierHarness(
+    const std::string & policy, const double timeout_sec = 1.0,
+    const double stamp_delta_sec = 0.0, const double innovation_m = 0.0)
+  {
+    rclcpp::NodeOptions options;
+    options.arguments(
+      {"--ros-args", "-r", "__ns:=/pose_covariance_modifier_test_" + std::to_string(next_id_++)});
+    options.parameter_overrides(
+      {
+        {"fusion_policy", policy},
+        {"threshold_gnss_stddev_yaw_deg_max", 0.3},
+        {"threshold_gnss_stddev_z_max", 0.1},
+        {"threshold_gnss_stddev_xy_bound_lower", 0.1},
+        {"threshold_gnss_stddev_xy_bound_upper", 0.25},
+        {"ndt_std_dev_bound_lower", 0.14},
+        {"ndt_std_dev_bound_upper", 0.30},
+        {"gnss_pose_timeout_sec", timeout_sec},
+        {"gnss_position_only_yaw_variance", 1.0},
+        {"gnss_ndt_max_stamp_delta_sec", stamp_delta_sec},
+        {"gnss_ndt_xy_innovation_max_m", innovation_m},
+        {"enable_debug_topics", false},
+      });
+    subject_ = std::make_shared<Node>(options);
+    helper_ = std::make_shared<rclcpp::Node>(
+      "helper", subject_->get_namespace(), rclcpp::NodeOptions{});
+    ndt_pub_ = helper_->create_publisher<Message>("input_ndt_pose_with_cov_topic", 10);
+    gnss_pub_ = helper_->create_publisher<Message>("input_gnss_pose_with_cov_topic", 10);
+    output_sub_ = helper_->create_subscription<Message>(
+      "output_pose_with_covariance_topic", 10,
+      [this](const Message::ConstSharedPtr msg) { outputs_.push_back(*msg); });
+    executor_.add_node(subject_);
+    executor_.add_node(helper_);
+    spin_until([this]() {
+      return ndt_pub_->get_subscription_count() == 1 &&
+             gnss_pub_->get_subscription_count() == 1 &&
+             subject_->count_publishers("output_pose_with_covariance_topic") == 1;
+    });
+  }
+
+  ~ModifierHarness()
+  {
+    executor_.remove_node(subject_);
+    executor_.remove_node(helper_);
+  }
+
+  Message make_message(
+    const double xy_stddev, const double z_stddev = 0.05,
+    const double yaw_stddev_deg = 0.1) const
+  {
+    Message msg;
+    msg.header.frame_id = "map";
+    msg.header.stamp = subject_->now();
+    msg.pose.pose.position.x = 10.0;
+    msg.pose.pose.position.y = -4.0;
+    msg.pose.pose.position.z = 2.0;
+    msg.pose.pose.orientation.w = 1.0;
+    msg.pose.covariance.fill(0.0);
+    msg.pose.covariance[0] = xy_stddev * xy_stddev;
+    msg.pose.covariance[7] = xy_stddev * xy_stddev;
+    msg.pose.covariance[14] = z_stddev * z_stddev;
+    msg.pose.covariance[21] = 0.01;
+    msg.pose.covariance[28] = 0.01;
+    msg.pose.covariance[35] = std::pow(yaw_stddev_deg * M_PI / 180.0, 2);
+    return msg;
+  }
+
+  void publish_ndt(const Message & msg)
+  {
+    ndt_pub_->publish(msg);
+    spin_for(30ms);
+  }
+
+  void publish_gnss(const Message & msg)
+  {
+    gnss_pub_->publish(msg);
+    spin_for(30ms);
+  }
+
+  void clear() {outputs_.clear();}
+  const std::vector<Message> & outputs() const {return outputs_;}
+
+private:
+  template<class Predicate>
+  void spin_until(Predicate predicate)
+  {
+    const auto deadline = std::chrono::steady_clock::now() + 2s;
+    while (!predicate() && std::chrono::steady_clock::now() < deadline) {
+      executor_.spin_some();
+      std::this_thread::sleep_for(5ms);
+    }
+    ASSERT_TRUE(predicate());
+  }
+
+  void spin_for(const std::chrono::milliseconds duration)
+  {
+    const auto deadline = std::chrono::steady_clock::now() + duration;
+    while (std::chrono::steady_clock::now() < deadline) {
+      executor_.spin_some();
+      std::this_thread::sleep_for(2ms);
+    }
+  }
+
+  inline static int next_id_{0};
+  rclcpp::executors::SingleThreadedExecutor executor_;
+  std::shared_ptr<Node> subject_;
+  std::shared_ptr<rclcpp::Node> helper_;
+  rclcpp::Publisher<Message>::SharedPtr ndt_pub_;
+  rclcpp::Publisher<Message>::SharedPtr gnss_pub_;
+  rclcpp::Subscription<Message>::SharedPtr output_sub_;
+  std::vector<Message> outputs_;
+};
