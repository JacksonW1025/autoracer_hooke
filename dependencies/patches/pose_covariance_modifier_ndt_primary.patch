+TEST(kalman_filter, repeated_precise_updates_preserve_covariance_invariants)
+{
+  constexpr int state_dimension = 60;
+  constexpr int measurement_dimension = 3;
+  Eigen::MatrixXd basis =
+    Eigen::MatrixXd::Random(state_dimension, state_dimension);
+  Eigen::MatrixXd covariance =
+    basis * basis.transpose() +
+    1.0e-6 * Eigen::MatrixXd::Identity(state_dimension, state_dimension);
+  Eigen::MatrixXd state = Eigen::MatrixXd::Zero(state_dimension, 1);
+  Eigen::MatrixXd measurement_matrix =
+    Eigen::MatrixXd::Zero(measurement_dimension, state_dimension);
+  measurement_matrix(0, 0) = 1.0;
+  measurement_matrix(1, 1) = 1.0;
+  measurement_matrix(2, 2) = 1.0;
+  Eigen::MatrixXd measurement_covariance =
+    1.0e-8 * Eigen::MatrixXd::Identity(
+      measurement_dimension, measurement_dimension);
+  Eigen::MatrixXd measurement(measurement_dimension, 1);
+  measurement << 1.0, -2.0, 0.5;
+
+  KalmanFilter filter;
+  ASSERT_TRUE(filter.init(state, covariance));
+  for (int iteration = 0; iteration < 2000; ++iteration) {
+    ASSERT_TRUE(
+      filter.update(
+        measurement, measurement_matrix, measurement_covariance));
+  }
+
+  Eigen::MatrixXd result_state;
+  Eigen::MatrixXd result_covariance;
+  filter.getX(result_state);
+  filter.getP(result_covariance);
+  EXPECT_TRUE(result_state.array().isFinite().all());
+  EXPECT_TRUE(result_covariance.array().isFinite().all());
+  EXPECT_LT(
+    (result_covariance - result_covariance.transpose()).cwiseAbs().maxCoeff(),
+    1.0e-12);
+  const Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> eigen_solver(
+    result_covariance);
+  ASSERT_EQ(eigen_solver.info(), Eigen::Success);
+  EXPECT_GE(eigen_solver.eigenvalues().minCoeff(), -1.0e-10);
+}
