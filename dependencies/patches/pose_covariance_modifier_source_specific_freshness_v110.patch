+TEST(PoseCovarianceModifier, ndt_and_gnss_use_independent_source_age_budgets)
+{
+  QualityContractOptions options;
+  options.gnss_timeout_sec = 0.05;
+  options.ndt_timeout_sec = 0.20;
+  ModifierHarness harness("ndt_primary_position", options);
+
+  const auto delayed_but_valid_ndt = harness.make_message(0.15);
+  std::this_thread::sleep_for(70ms);
+  harness.publish_ndt(delayed_but_valid_ndt);
+  ASSERT_EQ(harness.outputs().size(), 1U);
+  EXPECT_EQ(harness.outputs().front(), delayed_but_valid_ndt);
+
+  harness.clear();
+  const auto stale_gnss = harness.make_message(0.2);
+  std::this_thread::sleep_for(70ms);
+  harness.publish_gnss(stale_gnss);
+  EXPECT_TRUE(harness.outputs().empty());
+
+  const auto stale_ndt = harness.make_message(0.15);
+  std::this_thread::sleep_for(220ms);
+  harness.publish_ndt(stale_ndt);
+  EXPECT_TRUE(harness.outputs().empty());
+}
