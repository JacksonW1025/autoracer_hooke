+TEST(time_delay_kalman_filter, schmidt_position_update_can_condition_velocity_without_yaw)
+{
+  Eigen::MatrixXd state = Eigen::MatrixXd::Zero(8, 1);
+  Eigen::MatrixXd covariance = Eigen::MatrixXd::Identity(8, 8);
+  covariance(0, 2) = 0.3;
+  covariance(2, 0) = 0.3;
+  covariance(0, 4) = 0.4;
+  covariance(4, 0) = 0.4;
+  TimeDelayKalmanFilter filter;
+  filter.init(state, covariance, 3, 2);
+
+  Eigen::MatrixXd measurement(2, 1);
+  measurement << 1.0, 0.0;
+  Eigen::MatrixXd measurement_matrix = Eigen::MatrixXd::Zero(2, 8);
+  measurement_matrix(0, 0) = 1.0;
+  measurement_matrix(1, 1) = 1.0;
+  measurement_matrix(0, 6) = 1.0;
+  measurement_matrix(1, 7) = 1.0;
+  const Eigen::MatrixXd measurement_covariance =
+    0.05 * Eigen::MatrixXd::Identity(2, 2);
+  Eigen::VectorXi mask = Eigen::VectorXi::Zero(8);
+  mask(0) = 1;
+  mask(1) = 1;
+  mask(4) = 1;
+  mask(6) = 1;
+  mask(7) = 1;
+
+  Eigen::MatrixXd before_covariance;
+  filter.getP(before_covariance);
+  ASSERT_TRUE(
+    filter.updateWithDelayStateMask(
+      measurement, measurement_matrix, measurement_covariance, 0, mask));
+
+  Eigen::MatrixXd after_state;
+  Eigen::MatrixXd after_covariance;
+  filter.getX(after_state);
+  filter.getP(after_covariance);
+  EXPECT_GT(std::abs(after_state(4, 0)), 1.0e-3);
+  EXPECT_DOUBLE_EQ(after_state(2, 0), 0.0);
+  EXPECT_DOUBLE_EQ(after_covariance(2, 2), before_covariance(2, 2));
+  EXPECT_TRUE(after_covariance.isApprox(after_covariance.transpose(), 1.0e-12));
+  Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> solver(after_covariance);
+  ASSERT_EQ(solver.info(), Eigen::Success);
+  EXPECT_GE(solver.eigenvalues().minCoeff(), -1.0e-12);
+}
