+TEST(PoseCovarianceModifier, guarded_xy_and_independent_height_are_separable_after_ndt_timeout)
+{
+  ModifierHarness harness(
+    "ndt_primary_position", 0.05, 0.25, 3.0, false, 0.0, false, true, false,
+    0.5, 3, 0, true, 5.991464547107979, 13.815510557964274, 0.0, true, false);
+  const auto ndt = harness.make_message(0.15, 0.20);
+  auto gnss = harness.make_message(0.2, 0.05);
+  gnss.pose.pose.position.x += 0.25;
+  gnss.pose.pose.position.z += 0.10;
+
+  harness.publish_ndt(ndt);
+  harness.clear();
+  std::this_thread::sleep_for(70ms);
+  gnss.header.stamp = rclcpp::Time(ndt.header.stamp) + rclcpp::Duration::from_seconds(0.10);
+  harness.publish_gnss(gnss);
+
+  // Horizontal GNSS is withheld without a current independent NDT sample,
+  // while the separately gated height observation reaches the existing 1-D
+  // filter.  No GNSS yaw or GNSS-only localization path is introduced.
+  ASSERT_EQ(harness.outputs().size(), 1U);
+  const auto & height = harness.outputs().front();
+  EXPECT_DOUBLE_EQ(height.pose.pose.position.x, ndt.pose.pose.position.x);
+  EXPECT_DOUBLE_EQ(height.pose.pose.position.y, ndt.pose.pose.position.y);
+  EXPECT_DOUBLE_EQ(height.pose.pose.position.z, gnss.pose.pose.position.z);
+  EXPECT_DOUBLE_EQ(height.pose.covariance[0], 1000000.0);
+  EXPECT_DOUBLE_EQ(height.pose.covariance[7], 1000000.0);
+  EXPECT_DOUBLE_EQ(height.pose.covariance[14], 0.1089);
+  EXPECT_EQ(height.pose.pose.orientation, ndt.pose.pose.orientation);
+}
