+#include "autoware/ekf_localizer/gnss_correction.hpp"
+#include "autoware/ekf_localizer/state_index.hpp"
+
+#include <autoware/kalman_filter/kalman_filter.hpp>
+#include <gtest/gtest.h>
+
+namespace autoware::ekf_localizer {
+
+TEST(GnssCorrection, freshness_authority_has_frozen_boundaries) {
+  EXPECT_DOUBLE_EQ(desired_gnss_correction_authority(0.0, false, 0.25, 1.0),
+                   0.0);
+  EXPECT_DOUBLE_EQ(desired_gnss_correction_authority(0.25, true, 0.25, 1.0),
+                   1.0);
+  EXPECT_NEAR(desired_gnss_correction_authority(0.625, true, 0.25, 1.0), 0.5,
+              1.0e-12);
+  EXPECT_DOUBLE_EQ(desired_gnss_correction_authority(1.0, true, 0.25, 1.0),
+                   0.0);
+}
+
+TEST(GnssCorrection, authority_limits_only_reacquisition) {
+  EXPECT_NEAR(slew_gnss_correction_authority(0.2, 1.0, 0.02, 1.0), 0.22,
+              1.0e-12);
+  EXPECT_DOUBLE_EQ(slew_gnss_correction_authority(0.8, 0.3, 0.02, 1.0), 0.3);
+  EXPECT_DOUBLE_EQ(slew_gnss_correction_authority(0.8, 0.0, 0.02, 1.0), 0.0);
+}
+
+TEST(GnssCorrection, covariance_uses_receiver_floor_and_ndt_reference) {
+  Eigen::Matrix2d receiver;
+  receiver << 0.001, 0.002, 0.002, 0.04;
+  const Eigen::Matrix2d covariance =
+      regularized_position_measurement_covariance(receiver, 0.1, 0.4);
+  EXPECT_NEAR(covariance(0, 0), 0.17, 1.0e-12);
+  EXPECT_NEAR(covariance(1, 1), 0.20, 1.0e-12);
+  EXPECT_NEAR(covariance(0, 1), 0.002, 1.0e-12);
+  EXPECT_NEAR(covariance(1, 0), 0.002, 1.0e-12);
+}
+
+TEST(GnssCorrection, bias_only_update_cannot_move_local_motion_state) {
+  autoware::kalman_filter::KalmanFilter filter;
+  Eigen::VectorXd state = Eigen::VectorXd::Zero(8);
+  state(IDX::X) = 10.0;
+  state(IDX::Y) = 20.0;
+  state(IDX::YAW) = 0.4;
+  state(IDX::VX) = 3.0;
+  Eigen::MatrixXd covariance = Eigen::MatrixXd::Identity(8, 8);
+  covariance(IDX::GNSS_BX, IDX::GNSS_BX) = 0.04;
+  covariance(IDX::GNSS_BY, IDX::GNSS_BY) = 0.04;
+  ASSERT_TRUE(filter.init(state, covariance));
+
+  const Eigen::Vector2d relative_position(0.5, -0.3);
+  const Eigen::MatrixXd measurement_matrix =
+      position_only_bias_measurement_matrix(8);
+  const Eigen::Matrix2d measurement_covariance =
+      Eigen::Matrix2d::Identity() * 0.2;
+  Eigen::VectorXi update_mask = Eigen::VectorXi::Zero(8);
+  update_mask(IDX::GNSS_BX) = 1;
+  update_mask(IDX::GNSS_BY) = 1;
+  ASSERT_TRUE(filter.updateWithStateMask(relative_position, measurement_matrix,
+                                         measurement_covariance, update_mask));
+
+  Eigen::MatrixXd updated;
+  filter.getX(updated);
+  EXPECT_DOUBLE_EQ(updated(IDX::X), 10.0);
+  EXPECT_DOUBLE_EQ(updated(IDX::Y), 20.0);
+  EXPECT_DOUBLE_EQ(updated(IDX::YAW), 0.4);
+  EXPECT_DOUBLE_EQ(updated(IDX::VX), 3.0);
+  EXPECT_GT(updated(IDX::GNSS_BX), 0.0);
+  EXPECT_LT(updated(IDX::GNSS_BY), 0.0);
+}
+
+TEST(GnssCorrection, public_projection_changes_only_xy) {
+  Eigen::VectorXd state = Eigen::VectorXd::Zero(8);
+  state << 10.0, 20.0, 0.4, 0.01, 3.0, 0.2, 0.4, -0.2;
+  const Eigen::MatrixXd projection = public_pose_projection_matrix(8, 0.5);
+  const Eigen::VectorXd public_state = projection * state;
+  EXPECT_DOUBLE_EQ(public_state(IDX::X), 10.2);
+  EXPECT_DOUBLE_EQ(public_state(IDX::Y), 19.9);
+  EXPECT_DOUBLE_EQ(public_state(IDX::YAW), state(IDX::YAW));
+  EXPECT_DOUBLE_EQ(public_state(IDX::YAWB), state(IDX::YAWB));
+  EXPECT_DOUBLE_EQ(public_state(IDX::VX), state(IDX::VX));
+  EXPECT_DOUBLE_EQ(public_state(IDX::WZ), state(IDX::WZ));
+}
+
