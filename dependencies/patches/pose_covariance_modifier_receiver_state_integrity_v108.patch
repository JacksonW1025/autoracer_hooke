+TEST(PoseCovarianceModifier, official_policy_ignores_optional_receiver_status_contract)
+{
+  QualityContractOptions options;
+  options.required = true;
+  ModifierHarness harness("official", options);
+
+  const auto gnss = harness.make_message(0.2);
+  harness.publish_gnss(gnss);
+  ASSERT_EQ(harness.outputs().size(), 1U);
+  EXPECT_EQ(harness.outputs().front(), gnss);
+}
+
+TEST(PoseCovarianceModifier, quality_contract_rejects_missing_status)
+{
+  QualityContractOptions options;
+  options.required = true;
+  options.xy_upper_m = 1.5;
+  ModifierHarness harness("ndt_primary_position", options);
+
+  harness.publish_ndt(harness.make_message(0.15));
+  harness.clear();
+  harness.publish_gnss(harness.make_message(0.2));
+  EXPECT_TRUE(harness.outputs().empty());
+}
