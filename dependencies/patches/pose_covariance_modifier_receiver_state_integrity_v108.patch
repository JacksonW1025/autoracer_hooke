+void PoseCovarianceModifierNode::callback_gnss_quality_status(
+  const fixposition_driver_msgs::msg::FpaOdomstatus::ConstSharedPtr & msg_status)
+{
+  const rclcpp::Time stamp(msg_status->header.stamp, this->get_clock()->get_clock_type());
+  GnssSolutionQuality quality = GnssSolutionQuality::UNKNOWN;
+  if (msg_status->gnss1_status == msg_status->consts.GNSS_STATUS_RTK_FIXED) {
+    quality = GnssSolutionQuality::RTK_FIXED;
+  } else if (msg_status->gnss1_status == msg_status->consts.GNSS_STATUS_RTK_FLOAT) {
+    quality = GnssSolutionQuality::RTK_FLOAT;
+  } else if (msg_status->gnss1_status == msg_status->consts.GNSS_STATUS_SPP) {
+    quality = GnssSolutionQuality::SPP;
+  } else if (msg_status->gnss1_status == msg_status->consts.GNSS_STATUS_NO_FIX) {
+    quality = GnssSolutionQuality::NO_FIX;
+  }
+
+  gnss_quality_history_.push_back(
+    TimedGnssQuality{
+      stamp.nanoseconds(), quality,
+      msg_status->fusion_gnss1 == msg_status->consts.MEAS_STATUS_USED});
+  constexpr std::size_t max_quality_history_size = 128U;
+  while (gnss_quality_history_.size() > max_quality_history_size) {
+    gnss_quality_history_.pop_front();
+  }
+}
+
+std::optional<PoseCovarianceModifierNode::TimedGnssQuality>
+PoseCovarianceModifierNode::gnss_quality_for_stamp(const int64_t stamp_ns) const
+{
+  if (gnss_quality_history_.empty()) {
+    return std::nullopt;
+  }
+
+  const TimedGnssQuality * nearest = nullptr;
+  int64_t nearest_delta_ns = std::numeric_limits<int64_t>::max();
+  for (const auto & sample : gnss_quality_history_) {
+    const int64_t delta_ns = sample.stamp_ns >= stamp_ns
+      ? sample.stamp_ns - stamp_ns : stamp_ns - sample.stamp_ns;
+    if (delta_ns < nearest_delta_ns) {
+      nearest = &sample;
+      nearest_delta_ns = delta_ns;
+    }
+  }
+  const double nearest_delta_sec = static_cast<double>(nearest_delta_ns) * 1.0e-9;
+  if (
+    nearest == nullptr || !std::isfinite(nearest_delta_sec) ||
+    nearest_delta_sec > gnss_quality_status_max_stamp_delta_sec_) {
+    return std::nullopt;
+  }
+  return *nearest;
+}
+
+bool PoseCovarianceModifierNode::apply_gnss_quality_contract(
+  geometry_msgs::msg::PoseWithCovarianceStamped & msg)
+{
+  // Preserve all historical non-TM99 deployments unless they explicitly opt
+  // into the receiver-state contract.  The official policy never calls this
+  // function, so its upstream behavior remains byte-for-byte compatible.
+  if (!gnss_quality_status_required_) {
+    return true;
+  }
+
+  const rclcpp::Time stamp(msg.header.stamp, this->get_clock()->get_clock_type());
+  const auto quality = gnss_quality_for_stamp(stamp.nanoseconds());
+  if (!quality) {
+    RCLCPP_WARN(
+      this->get_logger(),
+      "GNSS position rejected because no source-time-aligned receiver solution status exists");
+    return false;
+  }
+  if (!quality->measurement_used) {
+    RCLCPP_WARN(this->get_logger(), "GNSS position rejected because receiver did not use GNSS1");
+    return false;
+  }
+
+  double state_floor_m = threshold_gnss_stddev_xy_bound_lower_;
+  switch (quality->quality) {
+    case GnssSolutionQuality::RTK_FIXED:
+      state_floor_m = std::max(state_floor_m, gnss_rtk_fixed_stddev_floor_m_);
+      break;
+    case GnssSolutionQuality::RTK_FLOAT:
+      if (!gnss_allow_rtk_float_) {
+        RCLCPP_WARN(this->get_logger(), "GNSS RTK-float position rejected by policy");
+        return false;
+      }
+      state_floor_m = std::max(state_floor_m, gnss_rtk_float_stddev_floor_m_);
+      break;
+    case GnssSolutionQuality::SPP:
+      if (!gnss_allow_spp_) {
+        RCLCPP_WARN(this->get_logger(), "GNSS SPP/PSRDIFF position rejected by policy");
+        return false;
+      }
