+unsigned int frame_seed(const int64_t base_seed,
+                        const builtin_interfaces::msg::Time &stamp) {
+  // SplitMix64 gives every frame a deterministic, well-distributed PCL seed
+  // while preserving identical sampling for the same input timestamp.
+  uint64_t value = static_cast<uint64_t>(base_seed);
+  value ^= static_cast<uint64_t>(static_cast<uint32_t>(stamp.sec)) << 32U;
+  value ^= static_cast<uint64_t>(stamp.nanosec);
+  value += 0x9e3779b97f4a7c15ULL;
+  value = (value ^ (value >> 30U)) * 0xbf58476d1ce4e5b9ULL;
+  value = (value ^ (value >> 27U)) * 0x94d049bb133111ebULL;
+  value ^= value >> 31U;
+  return static_cast<unsigned int>(value & 0xffffffffULL);
+}
+
+bool valid_deterministic_seed(const int64_t seed) {
+  return seed == -1 ||
+         (seed >= 0 &&
+          static_cast<uint64_t>(seed) <=
+              static_cast<uint64_t>(std::numeric_limits<unsigned int>::max()));
+}
+} // namespace
