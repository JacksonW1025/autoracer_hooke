+TEST(GnssCorrection, repeated_bias_only_updates_preserve_local_filter_numerically) {
+  autoware::kalman_filter::KalmanFilter reference;
+  autoware::kalman_filter::KalmanFilter candidate;
+  Eigen::VectorXd state = Eigen::VectorXd::Zero(8);
+  state(IDX::VX) = 2.0;
+  Eigen::MatrixXd covariance = Eigen::MatrixXd::Identity(8, 8) * 0.1;
+  ASSERT_TRUE(reference.init(state, covariance));
+  ASSERT_TRUE(candidate.init(state, covariance));
+
+  constexpr double dt = 0.02;
+  constexpr double decay = 0.996;
+  const Eigen::MatrixXd ndt_h = pose_measurement_matrix(8);
+  const Eigen::Matrix3d ndt_r = Eigen::Matrix3d::Identity() * 0.16;
+  const Eigen::MatrixXd bias_h = position_only_bias_measurement_matrix(8);
+  const Eigen::Matrix2d bias_r = Eigen::Matrix2d::Identity() * 10.0;
+  Eigen::VectorXi bias_mask = Eigen::VectorXi::Zero(8);
+  bias_mask(IDX::GNSS_BX) = 1;
+  bias_mask(IDX::GNSS_BY) = 1;
+
+  for (int step = 0; step < 100; ++step) {
+    for (auto * filter : {&reference, &candidate}) {
+      Eigen::MatrixXd current;
+      filter->getX(current);
+      ASSERT_TRUE(filter->predict(
+        predict_next_state_with_gnss_bias(current, dt, decay),
+        create_state_transition_matrix_with_gnss_bias(current, dt, decay),
+        process_noise_covariance_with_gnss_bias(1.0e-6, 1.0e-4, 1.0e-4, 1.0e-5)));
+      const Eigen::Vector3d ndt(0.04 * static_cast<double>(step), 0.01, 0.001);
+      ASSERT_TRUE(filter->update(ndt, ndt_h, ndt_r));
+    }
+    const Eigen::Vector2d bias_observation(0.3, -0.2);
+    ASSERT_TRUE(candidate.updateWithStateMask(bias_observation, bias_h, bias_r, bias_mask));
+
+    Eigen::MatrixXd reference_state;
+    Eigen::MatrixXd candidate_state;
+    Eigen::MatrixXd reference_covariance;
+    Eigen::MatrixXd candidate_covariance;
+    reference.getX(reference_state);
+    candidate.getX(candidate_state);
+    reference.getP(reference_covariance);
+    candidate.getP(candidate_covariance);
+    // The eight-state matrix operations can change the final rounding bit of
+    // the decoupled six-state block even though the masked Kalman gain is
+    // mathematically zero there. This bound is far below physical resolution.
+    constexpr double local_invariance_tolerance = 1.0e-12;
+    for (int index = IDX::X; index <= IDX::WZ; ++index) {
+      EXPECT_NEAR(candidate_state(index), reference_state(index), local_invariance_tolerance);
+    }
+    const Eigen::MatrixXd candidate_local_covariance =
+      candidate_covariance.topLeftCorner<6, 6>();
+    const Eigen::MatrixXd reference_local_covariance =
+      reference_covariance.topLeftCorner<6, 6>();
+    EXPECT_LE(
+      (candidate_local_covariance - reference_local_covariance).cwiseAbs().maxCoeff(),
+      local_invariance_tolerance);
+  }
+
+  Eigen::MatrixXd candidate_state;
+  candidate.getX(candidate_state);
+  EXPECT_GT(candidate_state(IDX::GNSS_BX), 0.0);
+  EXPECT_LT(candidate_state(IDX::GNSS_BY), 0.0);
+}
