    version: f24f324ef73307b0da6a8959735ecc9aca5ff133

  # Only packages listed in vendor-packages-rc.tsv are copied into the underlay.
  autoware/universe:
    type: git
    url: https://github.com/tier4/autoware_universe.git
    version: 33376986f8f2213edb43cdd3db52479e071cff9d

