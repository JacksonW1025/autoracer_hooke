  # Public 0.50.0 source plus the locked gnss_enabled patch is byte-equivalent
  # to the launcher package previously used by this product.
  autoware/launcher:
    type: git
    url: https://github.com/autowarefoundation/autoware_launch.git
    version: 0f3946af9c5ec1cba491681b6927c6fcf577ed25

